# Copy this file to .env next to claude-docker.sh (or in CLAUDE_DOCKER_DIR). 
# Every claude-docker session reads these variables each time you run 
# claude-docker, so edits take effect from your next session without 
# recreating the container.
#
# Format follows docker's .env file.
#
# WARNING: .env holds credentials, keep it out of version control.

# --- Authentication: set at most one --------------------------------------
# With none of these, run /login inside the container once. The login is
# kept in the config volume for that mount set.

# Claude subscription (Pro, Max, Team or Enterprise). Generate a token on
# the host with `claude setup-token`; it lasts a year.
#CLAUDE_CODE_OAUTH_TOKEN=

# Claude Console API key, billed to your API account. It takes priority
# over CLAUDE_CODE_OAUTH_TOKEN and /login, so don't set both. claude asks
# you once to approve it.
#ANTHROPIC_API_KEY=sk-ant-...

# --- LLM gateway or proxy (optional) --------------------------------------
#ANTHROPIC_BASE_URL=https://llm-gateway.example.com
# Token for a gateway that uses bearer auth (sent as "Authorization: Bearer
# <token>"). It takes priority over ANTHROPIC_API_KEY.
#ANTHROPIC_AUTH_TOKEN=

# --- Models (optional) ----------------------------------------------------
# Model for sessions: an alias (opus, sonnet, haiku) or a full model ID.
#ANTHROPIC_MODEL=opus
# Model the haiku alias resolves to, also used for background tasks.
# (Replaces the deprecated ANTHROPIC_SMALL_FAST_MODEL.)
#ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Effort: low, medium, high, xhigh, max, or auto. Overrides --effort and
# /effort.
#CLAUDE_CODE_EFFORT_LEVEL=high

# --- Network (optional) ---------------------------------------------------
# Inside the container, localhost is the container itself. To reach a proxy
# running on the host, use host.docker.internal (Docker Desktop).
#HTTPS_PROXY=http://host.docker.internal:3128
#NO_PROXY=localhost,127.0.0.1

# Turn off auto-updates, telemetry, error reporting and other nonessential
# traffic. Any value turns them off, even 0 or false; delete the line to
# turn them back on. New claude releases come from rebuilding the image
# (--build --no-cache) either way.
#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --- Git identity (optional) ----------------------------------------------
# The container has no ~/.gitconfig unless you mount one, e.g.
#   -r ~/.gitconfig:/home/node/.gitconfig
# Set these instead if you commit from inside the container.
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
#GIT_COMMITTER_NAME=Your Name
#GIT_COMMITTER_EMAIL=you@example.com

# --- Pass through from your shell (optional) ------------------------------
# A bare name copies the variable from your shell, so its value never has
# to be written in this file.
#GH_TOKEN